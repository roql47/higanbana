# Cloudflare Pages 캐시 정책. Vite 가 dist/ 루트로 그대로 복사한다.
# 여러 규칙이 겹치면 더 구체적인 경로의 값이 적용된다.

# Vite 가 파일명에 콘텐츠 해시를 박는 유일한 곳 → 영구 캐시 안전
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# public/ 에서 그대로 복사돼 파일명이 고정인 에셋.
# immutable 을 걸면 모델 교체 시 옛 파일이 남으므로 1일 + ETag 재검증.
/models/*
  Cache-Control: public, max-age=86400
/textures/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
/hdri/*
  Cache-Control: public, max-age=86400

# 오디오 매니페스트는 에셋 추가 시 바로 반영돼야 한다
/audio/manifest.json
  Cache-Control: public, max-age=300

/index.html
  Cache-Control: public, max-age=0, must-revalidate
