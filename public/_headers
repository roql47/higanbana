# Cloudflare Pages 캐시 정책. Vite 가 dist/ 루트로 그대로 복사한다.
# 주의: 겹치는 규칙은 우선순위가 아니라 '병합'된다. /audio/* 와 /audio/manifest.json 을
# 동시에 두면 Cache-Control 값이 두 개 이어붙어 깨지므로, 경로가 겹치지 않게 유지할 것.

# Vite 가 파일명에 콘텐츠 해시를 박는 유일한 곳 → 영구 캐시 안전
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# public/ 에서 그대로 복사돼 파일명이 고정인 에셋.
# immutable 을 걸면 모델 교체 시 옛 파일이 남으므로 1일 + ETag 재검증.
/models/*
  Cache-Control: public, max-age=86400
/textures/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
/hdri/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate
